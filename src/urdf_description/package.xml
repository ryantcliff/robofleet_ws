<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
<name>urdf_description</name>
  <version>0.0.0</version>
<description>Robot URDF/xacro model, meshes, and display/Gazebo launch files</description>
  <maintainer email="roboflock@proton.me">roboflock</maintainer>
  <license>Apache-2.0</license>

  <depend>xacro</depend>
  <depend>rviz2</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>joint_state_publisher_gui</depend>
  <!-- Gazebo Fortress via ros_gz (gazebo.launch.py). Gazebo Classic and
       ros2_control are no longer used; see GAZEBO_IGNITION_MIGRATION.md. -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <test_depend>python3-numpy</test_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
